# Copy to .env (same folder as compose.yaml) and replace every "change-me".
# Generate secrets with: openssl rand -hex 32

# --- Images ----------------------------------------------------------------
# Tag of the images you built (monoshiri-backend:<tag>, monoshiri-web:<tag>).
MONOSHIRI_VERSION=local

# --- Public address --------------------------------------------------------
# Port the bundled Caddy listens on.
HTTP_PORT=8080
# The URL you open in the browser. It is the CORS allow-list and the base of invite links.
# With HTTPS in front, use that URL, for example https://monoshiri.example.com
NEXT_FRONTEND_URL=http://localhost:8080
# Leave empty: the browser calls the page's own origin through the reverse proxy.
NEXT_PUBLIC_FASTAPI_BACKEND_URL=
NEXT_PUBLIC_ZERO_CACHE_URL=

# --- Secrets ---------------------------------------------------------------
# All four are required: compose refuses to start while one is empty.
# required: generate with openssl rand -hex 32
# JWT signing key.
SECRET_KEY=
# SearXNG refuses to start with its default key.
SEARXNG_SECRET=
# Admin password of the zero-cache sync service.
ZERO_ADMIN_PASSWORD=
# Postgres password. It is set when the database is first created; changing it later
# means changing it inside Postgres too.
DB_PASSWORD=
# Optional, defaults are fine: DB_USER=surfsense, DB_NAME=surfsense

# --- Accounts --------------------------------------------------------------
AUTH_TYPE=LOCAL
REGISTRATION_ENABLED=TRUE
# Sign-up is invite-only. Mint a link with:
#   docker compose exec backend python -m app.monoshiri invite --note "me"
# SIGNUP_OPEN=FALSE          # TRUE lets anyone register
# INVITE_TTL_SECONDS=604800  # invite link lifetime (7 days)

# --- Embeddings (llama.cpp + embed-proxy from deploy/ai) -------------------
EMBEDDING_MODEL=litellm://openai/qwen3-embedding-8b
EMBEDDING_API_BASE=http://embed-proxy:8000/v1
# Must equal the vector column size. It is fixed when the database is first created;
# the backend refuses to start on a mismatch. Qwen3-Embedding-0.6B: use 1024 and
# skip the embed-proxy.
EMBEDDING_DIMENSION=2000
# litellm's openai provider needs a non-empty key even for a local server.
OPENAI_API_KEY=llamacpp-local

# --- Reranker (llama.cpp from deploy/ai) -----------------------------------
RERANKERS_ENABLED=TRUE
RERANKERS_MODEL_NAME=qwen3-reranker-0.6b
RERANKERS_MODEL_TYPE=llamacpp_api
RERANKER_API_URL=http://llamacpp-rerank:11438/v1/rerank

# --- Document converter ----------------------------------------------------
# MINERU (deploy/mineru) or DOCLING (built in, slower, weaker on formulas).
ETL_SERVICE=MINERU
# Same value as MINERU_API_KEY in deploy/mineru/.env.
MINERU_API_KEY=change-me

# --- Speech to text --------------------------------------------------------
STT_SERVICE=local/base
